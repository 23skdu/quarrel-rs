# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Compiled binaries, object files and shared libraries (source files stay tracked)
*.exe
*.dll
*.so
*.dylib
*.a
*.o
*.obj
*.wasm
*.bin
*.app
*.deb
*.rpm
/build/
/out/
/dist/

# Model artifacts and local secrets (keep the placeholder tracked)
models/*
!models/.gitkeep
*.gguf
*.ggml
*.ggjt
*.safetensors
*.onnx
*.pt
*.pth
*.tflite
*.mlmodel
*.engine
*.plan
.env
.env.local

# Tooling output
*.profraw
coverage/

# Benchmark results are regenerated on every run; only baselines are committed.
artifacts/bench/results.json
artifacts/bench/results.md
artifacts/bench/*.tmp

# Python bytecode from scripts/bench.py and its tests.
__pycache__/
*.py[cod]

# Python virtual environments (never commit interpreters or installed packages)
.venv/
.venv-*/
venv/
venv-*/
ENV/
env/
.virtualenv/
.nox/
.tox/
