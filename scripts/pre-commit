#!/usr/bin/env bash
# Pre-commit gate for quarrel-rs.
#
# Installed by `make makehooks`. Deliberately fast: formatting and unit tests only.
# Heavyweight checks (clippy, audit, fuzz, Helm, OpenAPI drift) run in `make ci`.
set -euo pipefail

if ! command -v cargo >/dev/null 2>&1; then
    printf 'error: cargo not found on PATH; run "make tools" and reload your shell\n' >&2
    exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

printf '==> cargo fmt --all -- --check\n'
cargo fmt --all -- --check

printf '==> cargo test --workspace --locked --lib --bins\n'
cargo test --workspace --locked --lib --bins

printf 'pre-commit checks passed\n'
